    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.8.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
